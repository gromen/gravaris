---
import { Image } from "astro:assets";
import { resolveProjectImage } from "@/lib/resolve-image";

interface Props {
  project: {
    id: string;
    data: {
      title: string;
      description: string;
      image: string;
      date: Date;
      gallery?: string[];
    };
  };
}

const { project } = Astro.props;
const heroImage = resolveProjectImage(project.data.image);

const formattedDate = project.data.date.toLocaleDateString("pl-PL", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
});
---

<section class="py-12 md:py-20 bg-dark min-h-screen">
  <div class="container-custom max-w-4xl mx-auto px-4">
    <!-- Breadcrumb / Back link -->
    <a
      href="/#galeria"
      class="inline-flex items-center gap-2 text-gray-400 hover:text-primary transition-colors mb-8 group"
    >
      <svg
        class="w-5 h-5 transform group-hover:-translate-x-1 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"></path>
      </svg>
      <span>Powrót do galerii</span>
    </a>

    <!-- Main image -->
    <div
      class="relative aspect-video overflow-hidden rounded-lg mb-8 border border-white/10"
    >
      {heroImage ? (
        <Image
          src={heroImage}
          alt={project.data.title}
          width={1200}
          height={675}
          format="webp"
          quality={80}
          class="w-full h-full object-cover"
        />
      ) : (
        <img
          src={project.data.image}
          alt={project.data.title}
          width="1200"
          height="675"
          class="w-full h-full object-cover"
        />
      )}
    </div>

    <!-- Content -->
    <article class="space-y-6">
      <!-- Header -->
      <header class="border-b border-white/10 pb-6">
        <h1
          class="text-2xl md:text-4xl font-bold dark:text-white text-black mb-3"
        >
          {project.data.title}
        </h1>
        <div class="flex flex-wrap items-center gap-4 text-sm text-gray-400">
          <span class="flex items-center gap-2">
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
            Data realizacji: <span class="text-primary font-medium"
              >{formattedDate}</span
            >
          </span>
        </div>
      </header>

      <!-- Description -->
      <div
        class="dark:bg-white/5 bg-black/5 rounded-lg p-6 border dark:border-white/10 border-black/10"
      >
        <h2 class="text-lg font-semibold text-primary mb-3">Opis projektu</h2>
        <p class="dark:text-gray-300 text-black/80 leading-relaxed">
          {project.data.description}
        </p>
      </div>

      <!-- Gallery -->
      {project.data.gallery && project.data.gallery.length > 0 && (
        <div>
          <h2 class="text-lg font-semibold text-primary mb-4">Galeria zdjęć</h2>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
            {project.data.gallery.map((img, index) => {
              const resolved = resolveProjectImage(img);
              return (
                <button
                  type="button"
                  class="gallery-thumb aspect-video overflow-hidden rounded-lg border border-white/10 hover:border-primary transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary"
                  data-index={index}
                  data-src={resolved ? resolved.src : img}
                  aria-label={`Otwórz zdjęcie ${index + 1} z galerii`}
                >
                  {resolved ? (
                    <Image
                      src={resolved}
                      alt={`${project.data.title} - zdjęcie ${index + 1}`}
                      width={400}
                      height={225}
                      format="webp"
                      quality={75}
                      class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  ) : (
                    <img
                      src={img}
                      alt={`${project.data.title} - zdjęcie ${index + 1}`}
                      class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  )}
                </button>
              );
            })}
          </div>
        </div>
      )}

      <!-- Lightbox -->
      <div
        id="lightbox"
        class="fixed inset-0 z-50 bg-black/90 hidden items-center justify-center"
        role="dialog"
        aria-modal="true"
        aria-label="Przeglądaj galerię zdjęć"
      >
        <button
          type="button"
          id="lightbox-close"
          class="absolute top-4 right-4 text-white/70 hover:text-white z-10 cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary"
          aria-label="Zamknij"
        >
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <button
          type="button"
          id="lightbox-prev"
          class="absolute left-4 text-white/70 hover:text-white z-10 cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary"
          aria-label="Poprzednie zdjęcie"
        >
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          type="button"
          id="lightbox-next"
          class="absolute right-4 text-white/70 hover:text-white z-10 cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary"
          aria-label="Następne zdjęcie"
        >
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
        <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-[90vw] object-contain" />
      </div>

      <!-- Body content (markdown) -->
      <div
        class="prose prose-invert prose-lg max-w-none prose-headings:text-white prose-p:text-gray-300 prose-a:text-primary prose-strong:text-white"
      >
        <slot />
      </div>

      <!-- CTA -->
      <div class="pt-8 border-t border-white/10">
        <a
          href="/kontakt"
          class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-black font-semibold rounded-lg hover:bg-primary/90 transition-colors"
        >
          Zapytaj o podobny projekt
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </article>
  </div>
</section>

<script>
  function initLightbox() {
    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
    const thumbs = document.querySelectorAll(".gallery-thumb");
    if (!lightbox || !lightboxImg || thumbs.length === 0) return;

    const images = Array.from(thumbs).map((t) => (t as HTMLElement).dataset.src || "");
    let currentIndex = 0;
    let triggerElement: HTMLElement | null = null;

    function show(index: number) {
      triggerElement = document.activeElement as HTMLElement;
      currentIndex = index;
      lightboxImg.src = images[currentIndex];
      lightboxImg.alt = `Zdjęcie ${currentIndex + 1}`;
      lightbox!.classList.remove("hidden");
      lightbox!.classList.add("flex");
      document.getElementById("lightbox-close")?.focus();
    }

    function hide() {
      lightbox!.classList.add("hidden");
      lightbox!.classList.remove("flex");
      triggerElement?.focus();
    }

    thumbs.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        show(Number((thumb as HTMLElement).dataset.index));
      });
    });

    document.getElementById("lightbox-close")?.addEventListener("click", hide);
    document.getElementById("lightbox-prev")?.addEventListener("click", () => {
      show((currentIndex - 1 + images.length) % images.length);
    });
    document.getElementById("lightbox-next")?.addEventListener("click", () => {
      show((currentIndex + 1) % images.length);
    });

    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) hide();
    });

    document.addEventListener("keydown", (e) => {
      if (lightbox.classList.contains("hidden")) return;
      if (e.key === "Escape") hide();
      if (e.key === "ArrowLeft") show((currentIndex - 1 + images.length) % images.length);
      if (e.key === "ArrowRight") show((currentIndex + 1) % images.length);
    });
  }

  document.addEventListener("astro:page-load", initLightbox);
  initLightbox();
</script>
