---
import Layout from "@layouts/Layout.astro";
import { SITE_CONFIG } from "@config/site";
---

<Layout
  title="Kontakt | Gravaris - Roboty Ziemne"
  description="Skontaktuj się z nami. Wykopy stawów, odmulanie, roboty ziemne. Bezpłatna wycena."
>
  <main class="bg-dark min-h-screen">
    <!-- Hero section -->
    <section class="py-16 bg-gradient-to-b from-dark-card to-dark">
      <div class="container-custom">
        <div class="flex flex-col items-center justify-center text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
            Skontaktuj się <span class="text-primary">z nami</span>
          </h1>
          <div class="w-24 h-1 bg-primary rounded-full mb-6"></div>
          <p class="text-gray-400 max-w-2xl text-lg">
            Masz pytania? Chcesz uzyskać bezpłatną wycenę? Napisz do nas lub zadzwoń.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact section -->
    <section class="py-12 pb-20">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <!-- Contact form -->
          <div class="bg-dark-card border border-white/10 p-8">
            <h2 class="text-2xl font-bold text-white mb-6">Napisz do nas</h2>

            <form id="contact-form" class="space-y-6">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-300 mb-2">
                  Imię
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 bg-dark border border-white/10 text-white placeholder-gray-500 focus:border-primary focus:outline-none transition-colors"
                  placeholder="Twoje imię"
                />
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-gray-300 mb-2">
                  Email
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 bg-dark border border-white/10 text-white placeholder-gray-500 focus:border-primary focus:outline-none transition-colors"
                  placeholder="twoj@email.pl"
                />
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-gray-300 mb-2">
                  Wiadomość
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  class="w-full px-4 py-3 bg-dark border border-white/10 text-white placeholder-gray-500 focus:border-primary focus:outline-none transition-colors resize-none"
                  placeholder="Opisz swoje zapytanie..."
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full px-6 py-4 bg-primary hover:bg-accent text-dark font-semibold transition-colors flex items-center justify-center gap-2"
              >
                <span>Wyślij wiadomość</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
              </button>
            </form>

            <!-- Status messages -->
            <div id="form-status" class="mt-4 hidden">
              <div id="form-success" class="hidden p-4 bg-green-900/30 border border-green-500/50 text-green-400">
                Wiadomość została wysłana. Odpowiemy najszybciej jak to możliwe.
              </div>
              <div id="form-error" class="hidden p-4 bg-red-900/30 border border-red-500/50 text-red-400">
                <span id="error-message">Wystąpił błąd. Spróbuj ponownie.</span>
              </div>
            </div>
          </div>

          <!-- Contact info -->
          <div class="space-y-8">
            <div class="bg-dark-card border border-white/10 p-8">
              <h2 class="text-2xl font-bold text-white mb-6">Dane kontaktowe</h2>

              <div class="space-y-6">
                <a href={`tel:${SITE_CONFIG.contact.phoneRaw}`} class="flex items-start gap-4 group">
                  <div class="w-12 h-12 bg-primary/10 flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-gray-400 text-sm">Telefon</p>
                    <p class="text-white text-lg font-semibold group-hover:text-primary transition-colors">
                      {SITE_CONFIG.contact.phone}
                    </p>
                  </div>
                </a>

                <a href={`mailto:${SITE_CONFIG.contact.email}`} class="flex items-start gap-4 group">
                  <div class="w-12 h-12 bg-primary/10 flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-gray-400 text-sm">Email</p>
                    <p class="text-white text-lg font-semibold group-hover:text-primary transition-colors">
                      {SITE_CONFIG.contact.email}
                    </p>
                  </div>
                </a>

                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-primary/10 flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-gray-400 text-sm">Obszar działania</p>
                    <p class="text-white text-lg font-semibold">Cała Polska</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Quick CTA -->
            <div class="bg-primary/10 border border-primary/30 p-6">
              <p class="text-white mb-3">
                Potrzebujesz szybkiej wyceny? Zadzwoń bezpośrednio:
              </p>
              <a
                href={`tel:${SITE_CONFIG.contact.phoneRaw}`}
                class="inline-flex items-center gap-2 px-6 py-3 bg-primary hover:bg-accent text-dark font-semibold transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>{SITE_CONFIG.contact.phone}</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Map section -->
    <section class="pb-0">
      <div class="w-full h-[400px] grayscale hover:grayscale-0 transition-all duration-500">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2500000!2d19.0!3d52.0!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47009964a4640bbb%3A0x97573ca49cc55ea!2sPolska!5e0!3m2!1spl!2spl!4v1700000000000!5m2!1spl!2spl"
          width="100%"
          height="100%"
          style="border:0; filter: invert(90%) hue-rotate(180deg);"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Mapa Polski - Gravaris działa na terenie całej Polski"
        ></iframe>
      </div>
    </section>
  </main>
</Layout>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const statusDiv = document.getElementById('form-status');
    const successDiv = document.getElementById('form-success');
    const errorDiv = document.getElementById('form-error');
    const errorMessage = document.getElementById('error-message');

    if (!form || !statusDiv || !successDiv || !errorDiv || !errorMessage) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = submitBtn.innerHTML;

      // Show loading state
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <svg class="animate-spin w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Wysyłanie...</span>
      `;

      // Hide previous status
      statusDiv.classList.add('hidden');
      successDiv.classList.add('hidden');
      errorDiv.classList.add('hidden');

      try {
        const formData = new FormData(form);
        const response = await fetch('/api/contact', {
          method: 'POST',
          body: formData,
        });

        const data = await response.json();

        statusDiv.classList.remove('hidden');

        if (response.ok && data.success) {
          successDiv.classList.remove('hidden');
          form.reset();
        } else {
          errorDiv.classList.remove('hidden');
          errorMessage.textContent = data.error || 'Wystąpił błąd. Spróbuj ponownie.';
        }
      } catch (err) {
        statusDiv.classList.remove('hidden');
        errorDiv.classList.remove('hidden');
        errorMessage.textContent = 'Błąd połączenia. Sprawdź połączenie internetowe.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    });
  }

  document.addEventListener('astro:page-load', initContactForm);
  initContactForm();
</script>
